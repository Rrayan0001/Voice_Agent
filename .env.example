# Vapi AI API Keys
# Get your keys for free at https://vapi.ai/ (Dashboard -> API Keys)

# Client-side public key for WebRTC browser calls
VAPI_PUBLIC_KEY=

# Server-side private key (starts with secret UUID or vapi_)
VAPI_PRIVATE_KEY=

# Assistant ID (can be auto-generated by the app or copied from Vapi Dashboard)
VAPI_ASSISTANT_ID=
